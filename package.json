{
  "name": "housegame",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Dom - top-down action roguelike",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "render:warden": "blender --background --python tools/blender/render_warden.py -- --out .render/warden",
    "pack:warden": "python3 tools/pack_sheet.py .render/warden public/assets/warden.png",
    "warden": "npm run render:warden && npm run pack:warden"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
